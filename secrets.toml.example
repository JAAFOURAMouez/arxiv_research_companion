# Copy to .streamlit/secrets.toml for local use (git-ignored), or paste into
# Streamlit Community Cloud -> App -> Settings -> Secrets.
GROQ_API_KEY = "gsk_your_key_here"

# Optional overrides (same model as before, available on Groq)
# LLM_MODEL_NAME = "openai/gpt-oss-120b"
# LLM_PROVIDER = "groq"          # selected automatically when GROQ_API_KEY is set

# Alternative: Hugging Face Inference Providers (needs credits)
# HF_API_TOKEN = "hf_your_token_here"

# --- Retrieval / citations (all optional) ---
# RETRIEVAL_MODE = "dense"        # dense | bm25 | hybrid | hybrid_rerank  (choose from eval numbers)
# CITATIONS_ENFORCE = "true"      # validate [n] citations, repair once, drop uncited sentences
# CITATIONS_POLICY = "drop"       # drop | flag
# LLM_MAX_RETRIES = "3"           # retries on Groq HTTP 429/5xx
