# Copy to .env for local runs (git-ignored). On Render, set these in Dashboard -> Environment.
# Pick ONE way to run the model (visitors can also choose their own in the page's "Model" section):
#   a) local, free, no key:  LLM_PROVIDER=ollama  (ollama serve; ollama pull llama3.2)
#   b) hosted:               GROQ_API_KEY / OPENAI_API_KEY / OPENROUTER_API_KEY / HF_API_TOKEN
GROQ_API_KEY=gsk_your_key_here
# LLM_PROVIDER=ollama             # ollama | groq | openai | openrouter | huggingface_api
# LLM_MODEL_NAME=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# Evaluation judge (eval/): JUDGE_PROVIDER=ollama JUDGE_MODEL=qwen2.5:7b

# Optional overrides
# LLM_MODEL_NAME=openai/gpt-oss-120b
# LLM_PROVIDER=groq              # selected automatically when GROQ_API_KEY is set
# LLM_MAX_NEW_TOKENS=800
# HF_API_TOKEN=hf_your_token_here   # alternative: Hugging Face Inference Providers

# Retrieval / citations
# RETRIEVAL_MODE=dense            # dense | bm25 | hybrid | hybrid_rerank
# CITATIONS_ENFORCE=true
# CITATIONS_POLICY=drop           # drop | flag
# LLM_MAX_RETRIES=3

# Web server
# RATE_LIMIT_PER_MINUTE=10        # questions per minute per visitor (0 = no limit)
