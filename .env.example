# Copy to .env for local runs (git-ignored). On Render, set these in Dashboard -> Environment.
GROQ_API_KEY=gsk_your_key_here

# Optional overrides
# LLM_MODEL_NAME=openai/gpt-oss-120b
# LLM_PROVIDER=groq              # selected automatically when GROQ_API_KEY is set
# LLM_MAX_NEW_TOKENS=800
# HF_API_TOKEN=hf_your_token_here   # alternative: Hugging Face Inference Providers

# Retrieval / citations
# RETRIEVAL_MODE=dense            # dense | bm25 | hybrid | hybrid_rerank
# CITATIONS_ENFORCE=true
# CITATIONS_POLICY=drop           # drop | flag
# LLM_MAX_RETRIES=3

# Web server
# RATE_LIMIT_PER_MINUTE=10        # questions per minute per visitor (0 = no limit)
